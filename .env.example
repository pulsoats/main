# HTTP server
HTTP_ADDR=:8080
APP_BASE_URL=https://app.pulsoats.local
CORS_ALLOWED_ORIGINS=https://app.pulsoats.local,https://another-origin.example
APP_NAME=Pulsoats
JWT_SECRET=replace-me

# Optional bootstrap admin (leave empty to skip)
ROOT_ADMIN_EMAIL=
ROOT_ADMIN_PASSWORD=

# PostgreSQL
POSTGRES_DSN=postgres://pulsoats:password@postgres:5432/pulsoats?sslmode=disable

# External analysis Service
ANALYSIS_GRPC_ADDR=analysis:50051

# Vault Agent — аутентификация и выпуск TLS-сертификатов
# VAULT_ADDR: адрес Vault сервера
VAULT_ADDR=https://vault.internal:8200
# VAULT_ROLE_ID / VAULT_SECRET_ID: учётные данные AppRole для роли "main"
# Генерация: vault read auth/approle/role/main/role-id
#            vault write -f auth/approle/role/main/secret-id
VAULT_ROLE_ID=
VAULT_SECRET_ID=

# mTLS — пути к файлам сертификатов, которые пишет Vault Agent
# Vault Agent монтирует их в контейнер через shared volume (см. docker-compose.yaml)
GRPC_TLS_CERT_FILE=/run/certs/cert.pem
GRPC_TLS_KEY_FILE=/run/certs/key.pem
GRPC_TLS_CA_FILE=/run/certs/ca.pem

# AWS SES
SES_ACCESS_KEY=aws-access-key
SES_SECRET_KEY=aws-secret-key
SES_REGION=eu-central-1
SES_BASE_ENDPOINT=https://email.eu-central-1.amazonaws.com
SES_SENDER=noreply@pulsoats.com

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# Build-time (optional) GitHub token for private modules
GITHUB_TOKEN=
