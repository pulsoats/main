# HTTP server
HTTP_ADDR=:8080
APP_BASE_URL=https://pulsoats.com
CORS_ALLOWED_ORIGINS=https://pulsoats.com,https://api.pulsoats.com
APP_NAME=Pulsoats

# JWT — сгенерировать: openssl rand -hex 32
JWT_SECRET=replace-with-secure-random-secret

# Опциональный bootstrap root-admin (оставить пустым, если не нужен)
ROOT_ADMIN_EMAIL=
ROOT_ADMIN_PASSWORD=

# PostgreSQL
POSTGRES_DSN=postgres://pulsoats:changeme@postgres:5432/pulsoats?sslmode=disable

# Analysis gRPC
ANALYSIS_GRPC_ADDR=analysis:50051

# gRPC TLS
# Для локального запуска и docker-compose без mTLS — оставить true
GRPC_TLS_DISABLE=true
# Для production с mTLS — установить false и указать пути к сертификатам:
#GRPC_TLS_CERT_FILE=/run/certs/cert.pem
#GRPC_TLS_KEY_FILE=/run/certs/key.pem
#GRPC_TLS_CA_FILE=/run/certs/ca.pem

# AWS SES
SES_ACCESS_KEY=
SES_SECRET_KEY=
SES_REGION=eu-central-1
SES_BASE_ENDPOINT=https://email.eu-central-1.amazonaws.com
SES_SENDER=noreply@pulsoats.com

# Logging
# Уровень: debug | info | warn | error
LOG_LEVEL=info
# Формат: json | console  (json — prod, console — локальная разработка)
LOG_FORMAT=json

# Build-time: GitHub token для приватных модулей
GITHUB_TOKEN=
