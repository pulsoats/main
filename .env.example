# HTTP
HTTP_ADDR=:8080
APP_FRONTEND_URL=https://app.pulsoats.local
CORS_ALLOWED_ORIGINS=https://app.pulsoats.local
APP_NAME=Pulsoats
JWT_SECRET=replace-me

# Optional bootstrap admin (leave empty to skip)
ROOT_ADMIN_EMAIL=
ROOT_ADMIN_PASSWORD=

# PostgreSQL (used by app and migrate)
POSTGRES_USER=pulsoats
POSTGRES_PASSWORD=password
POSTGRES_DB=pulsoats
POSTGRES_PORT=5432
POSTGRES_DSN=postgres://pulsoats:password@postgres:5432/pulsoats?sslmode=disable

# Analysis gRPC
ANALYSIS_GRPC_ADDR=analysis:50051

# gRPC mTLS — client cert + CA for outgoing connections (analysis, live workers)
# Vault Agent writes these to /run/certs/ via shared volume
GRPC_TLS_DISABLE=false
GRPC_CERT_FILE=/run/certs/cert.pem
GRPC_KEY_FILE=/run/certs/key.pem
GRPC_CA_FILE=/run/certs/ca.pem
# CA private key — used by certgen to sign worker server certs
GRPC_CA_KEY_FILE=/run/certs/ca-key.pem

# Vault AppRole (authenticates vault-agent container)
VAULT_ADDR=https://vault.internal:8200
VAULT_ROLE_ID=
VAULT_SECRET_ID=

# AWS SES
SES_ACCESS_KEY=
SES_SECRET_KEY=
SES_REGION=eu-central-1
SES_BASE_ENDPOINT=
SES_SENDER=noreply@pulsoats.com

# Credentials encryption — 32-byte hex-encoded AES key
# Generate: openssl rand -hex 32
CREDENTIALS_KEY=

# Docker — TLS certs for connecting to remote Docker daemons (nodes)
# PEM content, newlines escaped as \n — or mount files and use paths
DOCKER_CA_CERT=
DOCKER_CERT=
DOCKER_KEY=

# Container registry (GHCR) — for pulling live worker image onto nodes
GHCR_USER=
GHCR_TOKEN=
LIVE_IMAGE_URL=ghcr.io/pulsoats/live:latest
# Override default TimescaleDB image deployed on nodes (optional)
# DOCKER_DB_IMAGE=timescale/timescaledb:latest-pg17

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# Build-time GitHub token for private modules
GITHUB_TOKEN=
